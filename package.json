{
  "name": "petio",
  "version": "0.6.6",
  "description": "Seven expressive desktop companions with reminders, playful physics and friend visits",
  "main": "src/main.cjs",
  "author": "Petio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "node tools/dev.cjs",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron tools/smoke.cjs",
    "helper": "node tools/build-helper.cjs",
    "dist": "node tools/build-helper.cjs && electron-builder --win nsis",
    "pack": "node tools/build-helper.cjs && electron-builder --dir",
    "dist:self-signed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dist-self-signed.ps1",
    "social:server": "node tools/social-server.cjs",
    "test:backend": "npm test --prefix backend",
    "smoke:social": "electron tools/social-smoke.cjs",
    "icon": "node tools/build-icon.cjs",
    "picker": "esbuild tools/emoji-picker.jsx --bundle --minify --format=iife --global-name=PetioEmoji --platform=browser --jsx=automatic --define:process.env.NODE_ENV=\\\"production\\\" --outfile=src/emoji-picker.js"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "frimousse": "^0.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "build": {
    "appId": "studio.petio.desktop",
    "productName": "Petio",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "asarUnpack": [
      "src/helper/aware.exe"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/petio.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/petio.ico",
      "uninstallerIcon": "build/petio.ico",
      "artifactName": "Petio-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "y000yal",
      "repo": "petio"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
